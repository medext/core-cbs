# Next Core — environment template. Copy to .env for local dev. NEVER commit real values.

# Profile: local | saas | onprem  (selects settings module wiring)
NEXT_CORE_PROFILE=local

# Django
DJANGO_SECRET_KEY=change-me-generate-a-real-one        # required; no default in non-local
DJANGO_DEBUG=true                                       # local only; forced false elsewhere
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL only — ADR-0003)
DATABASE_URL=postgres://nextcore@127.0.0.1:5433/next_core_dev

# Redis (cache/rate-limit/queues only — never a source of truth)
REDIS_URL=redis://127.0.0.1:6379/0

# Tenancy (Phase 2)
# Resolver: header (dev/test/staging behind trusted gateway) | static (on-premise)
NEXT_CORE_TENANT_RESOLVER=header
NEXT_CORE_TENANT_DIRECTORY=control              # control (SaaS registry) | static (on-prem)
# On-premise static tenant (required only when profile=onprem):
#NEXT_CORE_TENANT_ID=00000000-0000-0000-0000-000000000000
#NEXT_CORE_TENANT_SLUG=mainbank

# IAM boundary (ADR-0008) — external OIDC provider (Keycloak reference)
OIDC_ISSUER_TEMPLATE=http://localhost:8080/realms/{tenant}
OIDC_AUDIENCE=next-core
#OIDC_JWKS_URL_TEMPLATE={issuer}/protocol/openid-connect/certs

# Observability (optional; telemetry is a no-op when unset)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=next-core
LOG_LEVEL=INFO
